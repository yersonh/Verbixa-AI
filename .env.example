# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/verbixa_ai"

# Redis (BullMQ) — usa la connection string de tu servicio Redis en Railway en producción/staging
REDIS_URL="redis://localhost:6379"

# Clerk (Authentication + Organizations)
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# Signing secret for the Clerk webhook endpoint (Dashboard > Webhooks > tu endpoint > Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=""

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# Recall.ai (meeting bot / recording)
RECALL_API_KEY=""
# Región de tu workspace de Recall.ai: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_API_REGION="us-west-2"
# Secreto para verificar la firma del webhook (Dashboard > Developers > API Keys & Secrets)
RECALL_WEBHOOK_SECRET=""

# Deepgram (transcription)
DEEPGRAM_API_KEY=""

# Google Gemini (AI summarization)
GEMINI_API_KEY=""
